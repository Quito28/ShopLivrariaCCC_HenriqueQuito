@model ShopLivrariaCCC_HenriqueQuito.Models.DTOs.LivroDTO
@{
    ViewData["Title"] = "Update Livro";
    Layout = "AdminLayout";
}
<div style="width: 50%">
    <h2> Update Livro </h2>
    <a asp-action="Index" asp-controller="Livro" class="btn btn-primary">Voltar</a>
    <form asp-action="UpdateLivro" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Imagem" />

        <div class="my-2">
            <label>Livro*</label>
            <input type="text" class="form-control" asp-for="NomeLivro" />
            <span asp-validation-for="NomeLivro" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label>Autor*</label>
            <input type="text" class="form-control" asp-for="AutorNome" />
            <span asp-validation-for="AutorNome" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label>Genero*</label>
            <select class="form-control" asp-for="GeneroID" asp-items="Model.ListaGenero">
                <option value="">Selecione o Genero</option>
            </select>
            <span asp-validation-for="GeneroID" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label>Preço*</label>
            <input type="number" step="any" class="form-control" asp-for="Preco" />
            <span asp-validation-for="Preco" class="text-danger"></span>
        </div>

        <div class="my-2">
            <label>Image</label>
            @if (!string.IsNullOrEmpty(Model.Imagem))
            {
                <img src="/imagens/@Model.Imagem" style="width:100px; height: 120px" />
            }
            <input type="file" class="form-control" asp-for="ImagemArquivo" />
        </div>

        <div class="my-2">
            <button type="submit" class="btn btn-info">Atualizar</button>
        </div>
    </form>
</div>