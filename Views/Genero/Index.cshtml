@model IEnumerable<ShopLivrariaCCC_HenriqueQuito.Models.Genero>
@{
ViewData["Title"] = "Generos";
Layout = "AdminLayout";
}
<h1>Lista de Generos</h1>
<p>
<a asp-action="AddGenero">Novo Genero</a>
</p>
<table class="table">
<thead>
<tr>
<th>
@Html.DisplayName For(model => model. NomeGenero)
</th>
<th></th>
</tr>
</thead>
<tbody>
@foreach (var item in Model)
{
<tr>
<td>
@Html.DisplayFor(modelItem => item. NomeGenero)
</td>
<td>
    <a asp-action="UpdateGenero" asp-controller="Genero" asp-route-id="@item.Id" class="btn btn-success">Editar</a>
<a asp-action="DeleteGenero" asp-controller="Genero" asp-route-id="@item.Id" class="btn btn-danger" onclick="return window.confirm('Tem certeza que deseja deletar?')">Deletar</a>
</td>
</tr>
}
</tbody>
</table>