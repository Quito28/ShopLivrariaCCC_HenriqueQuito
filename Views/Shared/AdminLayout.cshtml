<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopLivrariaCCC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ShopLivrariaCCC.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="main-container">
        <div class="sidenav">
            <a class="navigation-link" href="/Home/Index"><i class="bi bi-house-door"></i> Home</a>
            <a href="/AdminOperacoes/AllPedidos" class="navigation-link"><i class="bi bi-receipt"></i> Pedidos</a>
            <a href="/Estoque/Index" class="navigation-link"><i class="bi bi-archive"></i> Estoque</a>
            <a href="/Genero/Index" class="navigation-link"><i class="bi bi-collection"></i> Generos</a>
            <a href="/Livro/Index" class="navigation-link">
                <i class="bi bi-book"></i>
                Livros
            </a>
            <a href="/Relatorio/TopLivrosVendidos" class="navigation-link"><i class="bi bi-bar-chart"></i> Itens mais vendidos</a>
        </div>
        <div class="right-panel">
            <nav class="nav-bar">
                <div class="nav-heading">Bem vindo @User.Identity?.Name</div>
                <div class="nav-actions">
                    <a href="/Identity/Account/Manage/Index" class="navigation-link"><i class="bi bi-gear"></i> Gerenciar Conta</a>

                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="navigation-link">
                            <i class="bi bi-box-arrow-left"></i> Sair
                        </button>
                    </form>
                </div>
            </nav>
            <div class="content">
                <div class="my-2">
                    <partial name="_Notificacoes" />
                </div>
                @RenderBody()
            </div>
        </div>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 ShopLivrariaCCC <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>