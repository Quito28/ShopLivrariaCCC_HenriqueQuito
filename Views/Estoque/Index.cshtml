@model IEnumerable<ShopLivrariaCCC_HenriqueQuito.Models.DTOs.EstoqueDisplayModel>
@{
}
ViewData["Title"] = "Estoque";
Layout = "AdminLayout";
<h2>Estoque</h2>
<form asp-action="Index" method="get" class="my-2 d-flex gap-2">
<input type="text" name="sTerm" class="form-control w-25" placeholder="Pesquisar
Livro" />
<button type="submit" class="btn btn-primary">Pesquisar</button>
<a asp-action="Index" asp-controller="Estoque" class="btn btn-primary">Limpar</a>
</form>
<table class="table table-bordered">
<tr>
<th>Livro</th>
<th>Estoque</th>
<th>Ações</th>
</tr>
@foreach (var item in Model)
{
<tr>
<td>@item.NomeLivro</td>
<td>@item.Quantidade</td>
<td>
<a asp-action="ManageEstoque" asp-controller="Estoque" asp-route-livroId="@item.LivroId" class="btn btn-info">Atualizar Estoque</a>
</td>
</tr>
}
</table>