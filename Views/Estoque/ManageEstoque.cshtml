@model ShopLivrariaCCC_HenriqueQuito.Models.DTOs.EstoqueDTO
@{
ViewData["Title"] = "Manage Estoque";
Layout = "AdminLayout";
}
<div style="width:50%">
<h2> Gerenciar Estoque </h2>
<a asp-action="Index" asp-controller="Estoque" class="btn btn-primary">Voltar</a>
<form asp-action="ManageEstoque">
<input type="hidden" asp-for="LivroId" />
<div class="my-2">
<label>Quantidade</label>
<input type="number" class="form-control" asp-for="Quantidade" />
<span asp-validation-for="Quantidade" class="text-danger"></span>
</div>
<div class="my-2">
<button type="submit" class="btn btn-info">Atualizar</button>
</div>
</form>
</div>
